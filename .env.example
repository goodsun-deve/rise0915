# 이 파일을 복사해 .env.local 로 이름을 바꾼 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않아요)

# [필수] Claude API 키 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# [선택] 사용할 Claude 모델 ID (비워두면 claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# [선택] 카카오 JavaScript 키 — 비워두면 카카오톡 공유 버튼이 숨겨져요
KAKAO_JS_KEY=

# [선택] IP당 하루 사용 횟수 (기본 20)
DAILY_LIMIT=20

# [선택] 사용량을 정확하게 세고 싶을 때만 — Upstash Redis REST 정보
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
